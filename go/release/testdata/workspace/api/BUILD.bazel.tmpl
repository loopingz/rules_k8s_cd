load("@rules_k8s_cd//lib:release.bzl", "release_component")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

sh_binary(
    name = "bin",
    srcs = ["bin.sh"],
    # The binary embeds its version: api/VERSION is in the component's
    # closure, so a merged release must not trigger another one.
    data = [":api.version"],
    deps = ["//lib:util"],
)

release_component(
    name = "api",
    release_targets = ["//tools:record_api"],
    targets = [":bin"],
    visibility = ["//visibility:public"],
)
