{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^lib/private/grype_toolchain.bzl$/',
      ],
      matchStringsStrategy: 'recursive',
      matchStrings: [
        '_binaries\\W=\\W({[^}]+)',
        'https://github.com/(?<packageName>[^/]+/(?<depName>[^/]+))/releases/download/(?<currentValue>[^/]+)/grype_\\d+\\.\\d+\\.\\d+(?<depType>[^"]*)",\\W"(?<currentDigest>[^"]+)"',
      ],
      autoReplaceStringTemplate: 'https://github.com/{{packageName}}/releases/download/{{newValue}}/grype_{{replace "v" "" newValue}}{{depType}}", "{{newDigest}}"',
      datasourceTemplate: 'github-release-attachments',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^lib/private/trivy_toolchain.bzl$/',
      ],
      matchStringsStrategy: 'recursive',
      matchStrings: [
        '_binaries\\W=\\W({[^}]+)',
        'https://github.com/(?<packageName>[^/]+/(?<depName>[^/]+))/releases/download/(?<currentValue>[^/]+)/trivy_\\d+\\.\\d+\\.\\d+(?<depType>[^"]*)",\\W"(?<currentDigest>[^"]+)"',
      ],
      autoReplaceStringTemplate: 'https://github.com/{{packageName}}/releases/download/{{newValue}}/trivy_{{replace "v" "" newValue}}{{depType}}", "{{newDigest}}"',
      datasourceTemplate: 'github-release-attachments',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^lib/private/kyverno_toolchain.bzl$/',
      ],
      matchStringsStrategy: 'recursive',
      matchStrings: [
        '_binaries\\W=\\W({[^}]+)',
        // Assets are kyverno-cli_v<version>_<os>_<arch>.tar.gz (the old kyverno_<version> pattern never matched,
        // which left the CLI on v1.15.1)
        'https://github.com/(?<packageName>[^/]+/(?<depName>[^/]+))/releases/download/(?<currentValue>[^/]+)/kyverno-cli_v\\d+\\.\\d+\\.\\d+(?<depType>[^"]*)",\\W"(?<currentDigest>[^"]+)"',
      ],
      autoReplaceStringTemplate: 'https://github.com/{{packageName}}/releases/download/{{newValue}}/kyverno-cli_{{newValue}}{{depType}}", "{{newDigest}}"',
      datasourceTemplate: 'github-release-attachments',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^lib/private/dive_toolchain.bzl$/',
      ],
      matchStringsStrategy: 'recursive',
      matchStrings: [
        '_binaries\\W=\\W({[^}]+)',
        'https://github.com/(?<packageName>[^/]+/(?<depName>[^/]+))/releases/download/(?<currentValue>[^/]+)/dive_\\d+\\.\\d+\\.\\d+(?<depType>[^"]*)",\\W"(?<currentDigest>[^"]+)"',
      ],
      autoReplaceStringTemplate: 'https://github.com/{{packageName}}/releases/download/{{newValue}}/dive_{{replace "v" "" newValue}}{{depType}}", "{{newDigest}}"',
      datasourceTemplate: 'github-release-attachments',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^lib/private/buildifier_toolchain.bzl$/',
      ],
      matchStringsStrategy: 'recursive',
      matchStrings: [
        '_binaries\\W=\\W({[^}]+)',
        'https://github.com/(?<packageName>[^/]+/(?<depName>[^/]+))/releases/download/(?<currentValue>[^/]+)/buildifier-(?<depType>[^"]*)",\\W"(?<currentDigest>[^"]+)"',
      ],
      autoReplaceStringTemplate: 'https://github.com/{{packageName}}/releases/download/{{newValue}}/buildifier-{{depType}}", "{{newDigest}}"',
      datasourceTemplate: 'github-release-attachments',
    },
  ],
  packageRules: [
    {
      description: 'Scanner updates ship new vulnerability detection, release them as fixes',
      matchDepNames: [
        'grype',
        'trivy',
      ],
      semanticCommitType: 'fix',
    },
  ],
}
